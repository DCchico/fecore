# # Import the image and name this first step as "builder" (for example)
FROM --platform=linux/x86_64 jonarod/tensorflow_lite_alpine as libtflite

# # You want to start your image with Alpine (this is the point...)
FROM --platform=linux/x86_64 ubuntu

# Do other things to construct your image...
# ...
# Do other things to construct your image...

# ================================
# HERE IS THE INTERESTING PART
# ================================
# We extract the `libtensorflowlite_c.so` file from the first step, 
# and put it into the `/usr/local/lib` of this very image
COPY --from=libtflite /home /usr/local/lib

# # IMPORTANT: let the linker system aware of the new library we put into /usr/local/lib
RUN ldconfig /usr/local/lib


COPY ./target/x86_64-unknown-linux-gnu/debug/native-inf-rs /opt
COPY ./lite-model_aiy_vision_classifier_birds_V1_3.tflite /opt
COPY ./birdx224x224x3.rgb /opt

# COPY /lib/x86_64-linux-gnu/ld-2.31.so /lib64/ld-linux-x86-64.so.2
# COPY ./ld-2.31.so /lib64/ld-linux-x86-64.so.2
# RUN ldconfig /lib64

# `ldd -ltensorflowlite_c` indicates we still requires libstdc++, so we install it
# RUN apk add --no-cache libstdc++

WORKDIR /opt

RUN ls 

ENTRYPOINT [ "./native-inf-rs" ]
